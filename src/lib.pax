<Scroller scroll_height=300% x=0% y=0% width=100% height=100%>
    <Stacker width=100% height=100% direction=StackerDirection::Vertical>
        <Group height=750px>
            <Image width=500px height=500px x=50% y=50% source=ImageSource::Url("assets/rock-band.png")/>
            <Text width=100% height=100px x=50% y=20% text="Welcome to Our Rock Band" style={
                font: Font::Web("ff-real-headline-pro", "https://use.typekit.net/ivu7epf.css", FontStyle::Normal, FontWeight::Bold)
                font_size: 48px
                fill: WHITE
                align_vertical: TextAlignVertical::Center
                align_horizontal: TextAlignHorizontal::Center
            }/>
        </Group>
        <Group height=500px>
            <Text width=80% height=100px x=50% y=10% text="About Us" style={
                font: Font::Web("ff-real-headline-pro", "https://use.typekit.net/ivu7epf.css", FontStyle::Normal, FontWeight::Bold)
                font_size: 36px
                fill: WHITE
                align_vertical: TextAlignVertical::Center
                align_horizontal: TextAlignHorizontal::Center
            }/>
            <Text width=80% height=300px x=50% y=50% 
                text="We are a passionate rock band bringing you the best of rock music. Join us on our musical journey!" style={
                    font: Font::Web("ff-real-headline-pro", "https://use.typekit.net/ivu7epf.css", FontStyle::Normal, FontWeight::Light)
                    font_size: 24px
                    fill: WHITE
                    align_vertical: TextAlignVertical::Top
                    align_horizontal: TextAlignHorizontal::Center
                }/>
        </Group>
        <Group height=500px>
            <Text width=80% height=100px x=50% y=10% text="Upcoming Shows" style={
                font: Font::Web("ff-real-headline-pro", "https://use.typekit.net/ivu7epf.css", FontStyle::Normal, FontWeight::Bold)
                font_size: 36px
                fill: WHITE
                align_vertical: TextAlignVertical::Center
                align_horizontal: TextAlignHorizontal::Center
            }/>
            <Text width=80% height=300px x=50% y=50% text="Stay tuned for our upcoming shows and events. We can't wait to rock with you!" 
                style={
                    font: Font::Web("ff-real-headline-pro", "https://use.typekit.net/ivu7epf.css", FontStyle::Normal, FontWeight::Light)
                    font_size: 24px
                    fill: WHITE
                    align_vertical: TextAlignVertical::Top
                    align_horizontal: TextAlignHorizontal::Center
                }/>
        </Group>
    </Stacker>
</Scroller>